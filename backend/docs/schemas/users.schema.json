{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "users",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "maxLength": 255
    },
    "hashed_password": {
      "type": "string",
      "maxLength": 255
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "engineer",
        "account_manager",
        "viewer"
      ]
    },
    "is_active": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "hashed_password",
    "role",
    "is_active",
    "id"
  ],
  "additionalProperties": false
}
