{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "links",
  "type": "object",
  "properties": {
    "from_site_id": {
      "type": "string",
      "format": "uuid"
    },
    "to_site_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "fiber",
        "microwave"
      ]
    },
    "is_protected": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "from_site_id",
    "to_site_id",
    "type",
    "is_protected",
    "status",
    "id"
  ],
  "additionalProperties": false
}
