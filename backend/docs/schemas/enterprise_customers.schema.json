{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "enterprise_customers",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "sector": {
      "type": "string",
      "maxLength": 255
    },
    "account_manager_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "sector",
    "id"
  ],
  "additionalProperties": false
}
