{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "market_items",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "competitor_tariff",
        "regulator",
        "spectrum"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 255
    },
    "summary": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "maxLength": 255
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "title",
    "summary",
    "source",
    "published_at",
    "id"
  ],
  "additionalProperties": false
}
