{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "customer_sites",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "leased_line",
        "private_apn",
        "mobile"
      ]
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_id",
    "site_id",
    "service_type",
    "id"
  ],
  "additionalProperties": false
}
