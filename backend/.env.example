# --- App ---
ENVIRONMENT=development
# development | staging | production
LOG_LEVEL=INFO
# 3001 because port 3000 may be taken by another project on this machine;
# the frontend's dev script runs on 3001 by default -- see frontend/.claude or package.json.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database ---
# Async driver (asyncpg) is used by the running app.
DATABASE_URL=postgresql+asyncpg://signos:signos@localhost:5432/signos
# Separate database for the test suite. Never pointed at the same DB as above.
TEST_DATABASE_URL=postgresql+asyncpg://signos:signos@localhost:5432/signos_test

POSTGRES_DB=signos
POSTGRES_USER=signos
POSTGRES_PASSWORD=signos

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin user, created on startup if no admin exists yet.
FIRST_ADMIN_EMAIL=admin@signos.app
FIRST_ADMIN_PASSWORD=change-me-admin-password

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AGENT_TIMEOUT_SECONDS=10

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INGESTION_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=20

# --- Background jobs ---
# How often the background worker polls for alarms written directly to the DB.
ALARM_WORKER_POLL_SECONDS=5.0
# How often GET /api/v1/incidents/{id}/stream re-checks the incident.
SSE_POLL_SECONDS=2.0
